<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Berkas API 27+ harus memuat isi yang sama dengan berkas dasar:
         pada Android, berkas berkualifikasi MENGGANTIKAN berkas dasar,
         bukan menggabungkan. Warna/cahaya bar sistem tidak lagi diatur
         di sini — semuanya dari kode (enableEdgeToEdge transparan). -->
    <style name="Theme.Bunny" parent="android:Theme.Material.NoActionBar">
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
    </style>
</resources>
