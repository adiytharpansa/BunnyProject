<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".BunnyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bunny"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Satu Pintu: the Desktop-client OAuth redirect lands
                 here (reversed-client-id scheme, injected by Gradle
                 from the same value the code reads). Scheme-only on
                 purpose: the redirect URI (...:/oauth2redirect) has
                 no host, and a path without a host trips lint's
                 AppLinkUrlError; the scheme itself is unique to our
                 client, and DesktopAuth validates the payload. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${desktopRedirectScheme}" />
            </intent-filter>
        </activity>

        <!-- Media3 session service: background playback + media notification.
             The foreground contract (mediaPlayback type + the permissions
             above) is what Android 14+ requires for this to start at all. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <!-- Action milik Media3 (androidx.media3.session.MediaSessionService).
                     Action androidx.media lama membuat resolusi SessionToken gagal dan
                     menjatuhkan setiap pembukaan video (laporan lapangan 2026-11-10).
                     Action android.media.session.MediaButtonReceiver dihapus: itu bukan
                     action yang dikenal Media3. -->
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
